    <string name="onboarding_welcome_title">Welcome to Clock &amp; Weather</string>
    <string name="onboarding_welcome_desc">Real-time local weather forecasts, hourly predictions, and customizable flip clock widgets right on your Android home screen.</string>
    <string name="onboarding_get_started">Get Started</string>
    <string name="onboarding_location_title">Location Access</string>
    <string name="onboarding_location_desc">To show live local forecasts and keep your home screen widgets updated as you travel, the app needs location access.</string>
