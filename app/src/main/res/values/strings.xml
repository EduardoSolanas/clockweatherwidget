    <string name="onboarding_battery_title">Reliable Background Updates</string>
    <string name="onboarding_battery_desc">Android restricts background activity to save power, which may delay widget updates. Granting unrestricted battery usage ensures your home screen widgets stay fresh and accurate.</string>
