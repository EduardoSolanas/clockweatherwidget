    <string name="onboarding_location_precise_desc">Used to fetch local weather and hourly forecasts for your exact area.</string>
    <string name="onboarding_location_background_title">Background Location (\"Allow all the time\")</string>
    <string name="onboarding_location_background_desc">Enables home screen widgets to refresh automatically without opening the app.</string>
